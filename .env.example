# =========================================================================
# .env.example — copie para .env e preencha para desenvolvimento local.
# NUNCA faça commit do .env com valores reais.
#
# Em produção (Lovable Cloud), configure via ferramentas de secrets do painel;
# valores VITE_* ficam expostos ao browser — use apenas chaves publishable.
# =========================================================================

# ---- Lovable Cloud / Supabase (públicas — publishable/anon) --------------
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="SEU-PROJETO"
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

# ---- URL pública da aplicação (usada em e-mails, webhooks, redirects) ----
# Definir em produção; em dev cai para http://localhost:8080.
PUBLIC_APP_URL="https://seu-dominio.com"
# Aliases aceitos: APP_URL, VITE_APP_URL

# ---- Secrets de runtime (NÃO expor ao browser) ---------------------------
# Gerenciados pelo painel Lovable (Backend > Secrets). Não coloque valores
# reais neste arquivo — listados aqui apenas como referência.
# CRON_SECRET=                         # autenticação dos cron jobs (obrigatório)
# REDEEM_HMAC_SECRET=                  # 32+ bytes aleatórios para QR temporário de resgate; obrigatório na VPS
#                                    # Gere com: openssl rand -base64 48
#                                    # Não reutilize URL pública, anon key ou token de outro serviço.
# SUPABASE_SERVICE_ROLE_KEY=          # gerenciado pela plataforma
# LOVABLE_API_KEY=                    # gerenciado pela plataforma
# RESEND_API_KEY=                     # e-mails transacionais
# MERCADOPAGO_ACCESS_TOKEN=           # pagamentos
# MERCADOPAGO_WEBHOOK_SECRET=         # verificação HMAC do webhook
# APPLE_PASS_TYPE_ID=                 # Wallet Apple
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_WWDR_PEM=
# GOOGLE_WALLET_ISSUER_ID=            # Wallet Google
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# SENTRY_DSN=                         # observabilidade

# ---- IA (assistente "Fidê") ---------------------------------------------
# Obrigatório em deploy próprio (VPS/Docker), pois LOVABLE_API_KEY só existe
# na infra da Lovable. Crie a chave em https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # opcional
INTEGRATIONS_ENCRYPTION_KEY=
